# Environment variables are read from the process. The CLI does not automatically
# load this file. Docker Compose reads .env; otherwise export the values yourself.
OPENREEL_DATA_DIR=.openreel
# Required for a public HTTPS deployment:
# OPENREEL_PUBLIC_URL=https://reel.example.com
# OPENREEL_OWNER_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional:
# OPENREEL_PIPER_MODELS=/absolute/path/to/voices
# OPENREEL_FFMPEG=/absolute/path/to/ffmpeg
# OPENREEL_FONT=/absolute/path/to/font.ttf
