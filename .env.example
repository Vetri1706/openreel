# Environment variables are read from the process. The CLI does not automatically
# load this file. Export values yourself. Docker Compose interpolates only variables
# referenced in its YAML; add environment entries and file mounts for optional features.
OPENREEL_DATA_DIR=.openreel
# Required for a public HTTPS deployment:
# OPENREEL_PUBLIC_URL=https://reel.example.com
# OPENREEL_OWNER_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional:
# OPENREEL_PIPER_MODELS=/absolute/path/to/voices
# OPENREEL_FFMPEG=/absolute/path/to/ffmpeg
# OPENREEL_FONT=/absolute/path/to/font.ttf
# Generation: owner-configured ComfyUI server and named API workflow definitions.
# OPENREEL_COMFYUI_URL=http://127.0.0.1:8188
# OPENREEL_COMFYUI_WORKFLOWS=/absolute/path/to/workflows.json
# OPENREEL_COMFYUI_TOKEN=optional-server-token
# Captions: install the captions extra; use already-downloaded local weights.
# OPENREEL_WHISPER_MODEL=/absolute/path/to/faster-whisper-model
# OPENREEL_WHISPER_DEVICE=cpu
# OPENREEL_WHISPER_COMPUTE_TYPE=int8
# Limits (MiB for upload size):
# OPENREEL_MAX_DURATION_SECONDS=7200
# OPENREEL_MAX_SCENES=1000
# OPENREEL_MAX_SCENE_SECONDS=600
# OPENREEL_MAX_UPLOAD_MB=500
# OPENREEL_MAX_QUEUED_RENDERS=32
# OPENREEL_RENDER_STAGE_TIMEOUT_SECONDS=3600
# Workers: disable embedded rendering on a coordinator if using separate workers.
# OPENREEL_RENDER_WORKER=0
# OPENREEL_WORKER_KEY=separate-random-worker-secret-at-least-32-characters
# OPENREEL_RENDER_SERVER=https://reel.example.com
